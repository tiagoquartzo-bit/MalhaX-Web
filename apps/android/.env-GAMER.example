# Chaves públicas do Supabase; variáveis EXPO_PUBLIC_* entram no bundle do app.
# Nunca salvar service_role, senha ou token administrativo aqui.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Chave pública restrita ao app Android (package name + SHA-1).
EXPO_PUBLIC_ANDROID_GOOGLE_MAPS_API_KEY=

